	(text "Inductor:							Vin	3.00...4.40\nL		= 1 uH						Fsw	1.10...0.90\n---------------------------------------\nD		= 1 - (Vin * n)/Vout		=	0.47...0.22\nIdc 	= (Vout * Iout)/(Vin * n) 	=	2.83...1.93\nIpp		= (Vin * D)/(L*Fsw)			=	1.55...0.87\nIp		= Idc + Ipp/2 				=	3.60...2.37\n\nChosen inductor: FWP252012P-1R0ML"
		(exclude_from_sim no)
